{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-pack.schema.json",
  "title": "Story pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "style_guide", "cast", "truths", "clues", "items", "locations", "twists", "red_herrings", "endings", "lengths"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "logline", "setting", "tone", "themes", "content_notes", "player"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/text" },
        "logline": { "$ref": "#/$defs/text" },
        "setting": { "$ref": "#/$defs/text" },
        "tone": { "$ref": "#/$defs/text" },
        "themes": { "$ref": "#/$defs/textList" },
        "content_notes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "player": { "$ref": "#/$defs/playerCharacter" }
      }
    },
    "style_guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrator_voice", "use", "avoid", "naming_conventions", "examples"],
      "properties": {
        "narrator_voice": { "$ref": "#/$defs/text" },
        "use": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "avoid": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "naming_conventions": { "$ref": "#/$defs/text" },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cast_id", "lines"],
            "properties": {
              "cast_id": { "$ref": "#/$defs/id" },
              "lines": { "$ref": "#/$defs/textList" }
            }
          }
        }
      }
    },
    "cast": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/castMember" } },
    "truths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/truth" } },
    "clues": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/clue" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "visual_requests": { "type": "array", "items": { "$ref": "#/$defs/visualRequest" } },
    "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/location" } },
    "twists": { "type": "array", "items": { "$ref": "#/$defs/twist" } },
    "red_herrings": { "type": "array", "items": { "$ref": "#/$defs/redHerring" } },
    "endings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ending" } },
    "lengths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "short": { "$ref": "#/$defs/length" },
        "medium": { "$ref": "#/$defs/length" },
        "long": { "$ref": "#/$defs/length" }
      }
    }
  },
  "$defs": {
    "hexColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "playerCharacter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "species", "description", "sprite"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "species": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "sprite": { "$ref": "#/$defs/sprite" }
      }
    },
    "sprite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "height", "girth", "skin"],
      "properties": {
        "species": { "type": "string", "enum": ["human", "bear", "dog", "cat", "fox", "mouse", "rabbit", "owl", "badger", "hedgehog", "otter", "frog", "sheep", "mole", "tortoise", "magpie", "crow", "wren", "heron", "moth"] },
        "height": { "type": "string", "enum": ["tiny", "short", "average", "tall"] },
        "girth": { "type": "string", "enum": ["slim", "average", "stout"] },
        "skin": { "$ref": "#/$defs/hexColor" },
        "accent": { "$ref": "#/$defs/hexColor" },
        "hair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "color"],
          "properties": { "style": { "type": "string", "enum": ["none", "short", "messy", "long", "bob", "bun", "ponytail", "curly", "balding", "pigtails", "mop"] }, "color": { "$ref": "#/$defs/hexColor" } }
        },
        "outfit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "color"],
          "properties": {
            "style": { "type": "string", "enum": ["none", "shirt", "jumper", "striped", "dress", "coat", "duffle-coat", "suit", "waistcoat", "uniform", "cape", "overalls", "cardigan", "robe", "smock"] },
            "color": { "$ref": "#/$defs/hexColor" },
            "trim": { "$ref": "#/$defs/hexColor" },
            "legs": { "$ref": "#/$defs/hexColor" }
          }
        },
        "headwear": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "color"],
          "properties": {
            "style": { "type": "string", "enum": ["none", "deerstalker", "bowler", "top-hat", "flat-cap", "bonnet", "headscarf", "bush-hat", "police-helmet", "chef-hat", "captain-cap", "peaked-cap", "beret", "woolly-hat", "straw-hat", "hood", "veil-hat"] },
            "color": { "$ref": "#/$defs/hexColor" },
            "trim": { "$ref": "#/$defs/hexColor" }
          }
        },
        "accessories": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": { "kind": { "type": "string", "enum": ["glasses", "monocle", "moustache", "beard", "brows", "pipe", "freckles", "scarf", "bowtie", "apron", "shawl", "locket", "nametag", "belt", "satchel", "cane", "umbrella", "spoon", "broom", "notebook", "basket", "lantern", "suitcase", "orange", "book", "spyglass", "medical-bag", "flower", "ball"] }, "color": { "$ref": "#/$defs/hexColor" } }
          }
        }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "textList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "idList": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": { "$ref": "#/$defs/idList" },
        "goal_states": { "$ref": "#/$defs/idList" },
        "truths": { "$ref": "#/$defs/idList" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["location", "character"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon"],
      "properties": {
        "icon": { "$ref": "#/$defs/id" },
        "accent": { "$ref": "#/$defs/text" },
        "states": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "visualRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "suggested_category"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "suggested_category": {
          "type": "string",
          "enum": ["container", "tool", "paper", "valuable", "clothing", "food", "nature", "furniture", "machine", "danger", "generic"]
        }
      }
    },
    "goalState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "requires"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "requires": { "$ref": "#/$defs/requirement" },
        "gives_items": { "$ref": "#/$defs/idList" },
        "reveals": { "$ref": "#/$defs/text" }
      }
    },
    "castMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "species", "personality", "goal", "secret", "motivations", "relationships", "sprite", "home_location", "knows_truths", "goal_states", "voice_notes", "greetings", "knowledge", "goal_hints", "deflections"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "species": { "$ref": "#/$defs/text" },
        "personality": { "$ref": "#/$defs/text" },
        "goal": { "$ref": "#/$defs/text" },
        "secret": { "$ref": "#/$defs/text" },
        "motivations": { "$ref": "#/$defs/textList" },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cast_id", "relation"],
            "properties": {
              "cast_id": { "$ref": "#/$defs/id" },
              "relation": { "$ref": "#/$defs/text" }
            }
          }
        },
        "sprite": { "$ref": "#/$defs/sprite" },
        "home_location": { "$ref": "#/$defs/id" },
        "knows_truths": { "$ref": "#/$defs/idList" },
        "goal_states": { "type": "array", "items": { "$ref": "#/$defs/goalState" } },
        "voice_notes": { "$ref": "#/$defs/text" },
        "greetings": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/text" } },
        "knowledge": { "type": "array", "minItems": 5, "maxItems": 8, "items": { "$ref": "#/$defs/knowledgeItem" } },
        "goal_hints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unmet", "in_progress", "resolved"],
          "properties": {
            "unmet": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } },
            "in_progress": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } },
            "resolved": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } }
          }
        },
        "deflections": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/text" } },
        "reactions": { "type": "array", "items": { "$ref": "#/$defs/reaction" } }
      }
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "about", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "about": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "type": "string", "enum": ["cast", "item", "clue"] },
            "id": { "$ref": "#/$defs/id" }
          }
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 140 },
        "requires": { "$ref": "#/$defs/requirement" },
        "clue_id": { "$ref": "#/$defs/id" }
      }
    },
    "knowledgeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "ask", "text", "keywords"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "topic": { "type": "string", "minLength": 1, "maxLength": 30 },
        "ask": { "type": "string", "minLength": 1, "maxLength": 80 },
        "text": { "type": "string", "minLength": 1, "maxLength": 140 },
        "keywords": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/text" } },
        "clue_id": { "$ref": "#/$defs/id" },
        "truth_id": { "$ref": "#/$defs/id" }
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "depends_on", "importance", "revealed_by"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/text" },
        "depends_on": { "$ref": "#/$defs/idList" },
        "importance": { "type": "string", "enum": ["core", "side"] },
        "revealed_by": { "$ref": "#/$defs/idList" },
        "deduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "answer", "wrong_answers"],
          "properties": {
            "question": { "$ref": "#/$defs/text" },
            "answer": { "$ref": "#/$defs/text" },
            "wrong_answers": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/text" } },
            "rules_out": { "$ref": "#/$defs/idList" }
          }
        }
      }
    },
    "clue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "where", "alternatives", "requirements", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "truth_id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "enum": ["spoken", "object", "place", "item_combination"] },
        "where": { "$ref": "#/$defs/sourceRef" },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "object_id": { "$ref": "#/$defs/id" },
        "requirements": { "$ref": "#/$defs/requirement" },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "icon_recipe", "key", "purpose"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "icon_recipe": { "$ref": "#/$defs/text" },
        "visual": { "$ref": "#/$defs/visual" },
        "key": { "type": "boolean" },
        "found_at": { "$ref": "#/$defs/sourceRef" },
        "found_requires": { "$ref": "#/$defs/requirement" },
        "purpose": { "$ref": "#/$defs/text" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "biome", "mood", "palette", "role", "hub", "required_characters", "objects", "doors"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "biome": { "$ref": "#/$defs/text" },
        "mood": { "$ref": "#/$defs/text" },
        "palette": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "hub": { "type": "boolean" },
        "required_characters": { "$ref": "#/$defs/idList" },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" },
              "visual": { "$ref": "#/$defs/visual" }
            }
          }
        },
        "doors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "to"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "to": { "$ref": "#/$defs/id" },
              "lock": { "$ref": "#/$defs/requirement" }
            }
          }
        },
        "area": { "$ref": "#/$defs/area" }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "doors", "biome", "palette", "floor", "wall", "map", "placements", "decor"],
      "properties": {
        "description": { "$ref": "#/$defs/text" },
        "doors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "label", "hint"],
            "properties": {
              "to": { "$ref": "#/$defs/id" },
              "label": { "$ref": "#/$defs/text" },
              "hint": { "$ref": "#/$defs/text" }
            }
          }
        },
        "biome": { "enum": ["meadow", "forest", "shore", "cave", "building", "ruins", "village"] },
        "palette": { "enum": ["meadow", "forest", "cave", "ruins", "shore", "village", "dusk", "mist", "cottage", "kitchen", "parlour", "shop", "workshop", "office", "london", "park", "market", "lighthouse", "underwater"] },
        "floor": { "enum": ["boards", "tiles", "carpet", "flagstone", "cobble", "dirt", "grass", "sand", "deck"] },
        "wall": { "enum": ["plaster", "brick", "wood", "stone", "hedge", "rock", "fence"] },
        "map": { "type": "array", "items": { "type": "string" } },
        "placements": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "decor": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["icon", "x", "y"],
            "properties": {
              "icon": { "type": "string" },
              "x": { "type": "integer" },
              "y": { "type": "integer" }
            }
          }
        }
      }
    },
    "twist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "setup_clues", "payoff_trigger"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "setup_clues": { "$ref": "#/$defs/idList" },
        "payoff_trigger": { "$ref": "#/$defs/requirement" }
      }
    },
    "redHerring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "setup_clues", "resolution"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "setup_clues": { "$ref": "#/$defs/idList" },
        "resolution": { "$ref": "#/$defs/text" }
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "conditions", "scene_outline", "tone", "epilogue_notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["truths", "goal_states", "choices"],
          "properties": {
            "truths": { "$ref": "#/$defs/idList" },
            "goal_states": { "$ref": "#/$defs/idList" },
            "choices": { "$ref": "#/$defs/idList" }
          }
        },
        "summation": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "truth_id"],
            "properties": {
              "question": { "$ref": "#/$defs/text" },
              "truth_id": { "$ref": "#/$defs/id" }
            }
          }
        },
        "scene_outline": { "$ref": "#/$defs/text" },
        "tone": { "$ref": "#/$defs/text" },
        "epilogue_notes": { "$ref": "#/$defs/text" }
      }
    },
    "length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_minutes", "start_location", "cast", "core_truths", "side_truths", "subplots", "twists", "red_herrings", "endings", "beats"],
      "properties": {
        "target_minutes": { "type": "integer", "minimum": 1 },
        "start_location": { "$ref": "#/$defs/id" },
        "opening": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context"],
          "properties": {
            "context": { "$ref": "#/$defs/text" }
          }
        },
        "cast": { "$ref": "#/$defs/idList" },
        "core_truths": { "$ref": "#/$defs/idList" },
        "side_truths": { "$ref": "#/$defs/idList" },
        "subplots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "description", "cast", "truths"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" },
              "cast": { "$ref": "#/$defs/idList" },
              "truths": { "$ref": "#/$defs/idList" }
            }
          }
        },
        "twists": { "$ref": "#/$defs/idList" },
        "red_herrings": { "$ref": "#/$defs/idList" },
        "endings": { "$ref": "#/$defs/idList" },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "locations", "must_find"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/text" },
              "objective": { "$ref": "#/$defs/text" },
              "guidance": { "$ref": "#/$defs/text" },
              "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
              "must_find": { "$ref": "#/$defs/requirement" }
            }
          }
        }
      }
    }
  }
}
